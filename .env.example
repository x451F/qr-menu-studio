# QR Menu Studio: production configuration for docker compose.
# Copy to `.env` (never commit it) and edit. Every variable is optional for a local trial:
# `docker compose up --build` works without a .env file (demo data, http://localhost:8080).

# --- Django -------------------------------------------------------------------------------
# Long random string. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# REQUIRED in production (the built-in default is public and insecure).
DJANGO_SECRET_KEY=change-me

# Comma-separated host names Django will answer to. Use your domain (no scheme).
DJANGO_ALLOWED_HOSTS=menu.example.fr

# Comma-separated origins allowed to POST to the admin over HTTPS (with scheme).
# Defaults to PUBLIC_BASE_URL when omitted.
DJANGO_CSRF_TRUSTED_ORIGINS=https://menu.example.fr

# Public URL printed inside the QR codes. No trailing slash. Menu URLs are
# PUBLIC_BASE_URL/m/<slug>/ and must never change once QR codes are printed.
PUBLIC_BASE_URL=https://menu.example.fr

# --- Web server (Caddy) ---------------------------------------------------------------------
# Domain to serve. A real domain gets a free HTTPS certificate automatically (ports 80 and 443
# must be reachable and the DNS A/AAAA record must point to this server).
# Use ":80" for plain HTTP (local trials, or behind another proxy).
SITE_ADDRESS=menu.example.fr

# Host ports. Local default is 8080/8443; in production use 80 and 443.
HTTP_PORT=80
HTTPS_PORT=443

# --- Admin account --------------------------------------------------------------------------
# Created/updated at every start when ADMIN_PASSWORD is set. Use a long unique password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# --- AI import and translation (optional) --------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to hide the AI buttons.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 1 = return canned AI results without calling the API (demos, tests).
AI_FAKE=0

# --- Misc -----------------------------------------------------------------------------------
# 1 = load the demo restaurants on first start when the database is empty. Use 0 in production.
SEED_DEMO=0

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
